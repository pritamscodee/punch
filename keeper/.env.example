# PUNCH keeper configuration. Copy to .env and fill in.

# NeonDB Postgres connection string, e.g.
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/punch?sslmode=require
# Leave empty to run with in-memory storage (data is lost on restart).
DATABASE_URL=

# Keeper signer (base58 secret key). Generate with: cargo run -- keygen
# This key is the SPL delegate members approve, the tSKR mint authority and the faucet payer.
KEEPER_SECRET=

# Solana RPC endpoint. Devnet by default.
RPC_URL=https://api.devnet.solana.com

# Mainnet RPC used to verify Seeker Genesis Tokens (they only exist on mainnet).
SGT_RPC_URL=https://api.mainnet-beta.solana.com

# HTTP port and how often closed shifts are settled.
PORT=8787
SETTLE_INTERVAL_SECS=30
